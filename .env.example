# Copy to .env (docker compose reads it automatically). The backend reads the same names from the environment;
# every value below is also the built-in default, so the app runs without any of them set.

# --- Database (PostgreSQL + PostGIS, see docker-compose.yml) ---
DB_HOST=localhost
DB_PORT=5433
DB_NAME=mumbai_ops
DB_USER=ops
DB_PASSWORD=ops_dev_password

# --- Backend ---
SERVER_PORT=8081
# 127.0.0.1 = only this computer. Use 0.0.0.0 to expose it on your network, and then also set ADMIN_TOKEN.
SERVER_ADDRESS=127.0.0.1
# If set, every admin action (POST) needs header X-Admin-Token; the dashboard asks for it once. Empty = no check.
ADMIN_TOKEN=

# --- Road routing (OSRM). Public demo server by default; point at your own OSRM for heavy use. ---
OSRM_URL=https://router.project-osrm.org/table/v1/driving/

# --- Simulation ---
# One tick = one simulated minute. SIM_TICK_MS is how long a tick takes in real time.
SIM_TICK_MS=1000
SIM_SEED=42
# Days of simulated order history generated on first start (feeds forecasts, AOV, weekday/weekend).
SIM_HISTORY_DAYS=21
SIM_AUTOSTART=true
